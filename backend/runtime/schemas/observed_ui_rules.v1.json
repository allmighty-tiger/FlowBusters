{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowbusters.local/schemas/observed_ui_rules.v1.json",
  "title": "FlowBusters observed UI rules v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["schema_version", "id", "statement", "facts", "inference"],
    "properties": {
      "schema_version": {"const": 1},
      "id": {"pattern": "^UIR-[0-9]{3,}$"},
      "statement": {"type": "string", "minLength": 1},
      "facts": {
        "type": "array",
        "minItems": 1,
        "contains": {
          "oneOf": [
            {"$ref": "#/$defs/explicitText"},
            {"$ref": "#/$defs/uiTransition"}
          ]
        },
        "items": {
          "oneOf": [
            {"$ref": "#/$defs/explicitText"},
            {"$ref": "#/$defs/uiTransition"},
            {"$ref": "#/$defs/apiTransition"}
          ]
        }
      },
      "inference": {
        "type": "object",
        "required": ["provenance_type", "text", "derived_from"],
        "properties": {
          "provenance_type": {"const": "agent_inference"},
          "text": {"type": "string", "minLength": 1},
          "derived_from": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "baseFact": {
      "type": "object",
      "required": ["id", "type", "provenance_type", "source_run", "artifact"]
    },
    "explicitText": {
      "allOf": [
        {"$ref": "#/$defs/baseFact"},
        {
          "properties": {
            "id": {"pattern": "^UIR-[0-9]{3,}-F[0-9]+$"},
            "type": {"const": "explicit_ui_text"},
            "provenance_type": {"const": "explicit_visible_ui_text"},
            "source_run": {"type": "string"},
            "artifact": {"const": "demo.json"},
            "step": {"type": "integer", "minimum": 1},
            "text": {"type": "string", "minLength": 1},
            "json_pointer": {"type": "string", "pattern": "^/"}
          },
          "required": ["step", "text", "json_pointer"],
          "additionalProperties": false
        }
      ]
    },
    "uiTransition": {
      "allOf": [
        {"$ref": "#/$defs/baseFact"},
        {
          "properties": {
            "id": {"pattern": "^UIR-[0-9]{3,}-F[0-9]+$"},
            "type": {"const": "ui_element_transition"},
            "provenance_type": {"const": "observed_ui_affordance"},
            "source_run": {"type": "string"},
            "artifact": {"const": "demo.json"},
            "before_step": {"type": "integer", "minimum": 1},
            "after_step": {"type": "integer", "minimum": 1},
            "element": {
              "type": "object",
              "required": ["role", "name"],
              "properties": {"role": {"type": "string"}, "name": {"type": "string"}},
              "additionalProperties": false
            },
            "transition": {"enum": ["appeared", "disappeared", "became_enabled", "became_disabled"]},
            "json_pointers": {"$ref": "#/$defs/pointerPair"}
          },
          "required": ["before_step", "after_step", "element", "transition", "json_pointers"],
          "additionalProperties": false
        }
      ]
    },
    "apiTransition": {
      "allOf": [
        {"$ref": "#/$defs/baseFact"},
        {
          "properties": {
            "id": {"pattern": "^UIR-[0-9]{3,}-F[0-9]+$"},
            "type": {"const": "api_field_transition"},
            "provenance_type": {"const": "api_state_fact"},
            "source_run": {"type": "string"},
            "artifact": {"const": "recording.har"},
            "field_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "before": {},
            "after": {},
            "entry_indexes": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false},
            "json_pointers": {"$ref": "#/$defs/pointerPair"}
          },
          "required": ["field_path", "before", "after", "entry_indexes", "json_pointers"],
          "additionalProperties": false
        }
      ]
    },
    "pointerPair": {
      "type": "object",
      "required": ["before", "after"],
      "properties": {"before": {"type": "string", "pattern": "^/"}, "after": {"type": "string", "pattern": "^/"}},
      "additionalProperties": false
    }
  }
}
