# FlowBusters Portal Configuration
# Copy to .env and fill in actual values

# Claude API
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5

# CORS
CORS_ORIGINS=http://localhost:3000

# Artifacts storage (local filesystem)
ARTIFACTS_DIR=.

# App
APP_ENV=development

# V2 Crew Runner
# Claude Code executable (default: claude)
CLAUDE_CODE_BIN=claude

# Per-phase timeout (seconds)
PHASE_TIMEOUT=600

# Overall assessment timeout (seconds)
ASSESSMENT_TIMEOUT=1800

# MCP config path passed to Claude Code
MCP_CONFIG_PATH=./mcp.json

# Vendored crew directory (default: ./crew)
CREW_DIR=./crew
